<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted connections only, trusting only the certificate authorities that ship with Android:
     a certificate a user or an app installed cannot be used to read reports in transit. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
